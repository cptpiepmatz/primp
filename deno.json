{
  "name": "@cptpiepmatz/pretty-ts-imports",
  "version": "2.0.0",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "imports": {
    "typescript": "npm:typescript@^6.0.0",
    "yargs": "npm:yargs@^18.2.0",
    "@types/yargs": "npm:@types/yargs@^17.0.35"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false
  },
  "tasks": {
    "check": "deno check",
    "test": "deno task test:*",
    "test:deno": "deno test --allow-read --allow-write --allow-env tests/**/*.test.ts",
    "test:node": "node --test tests/**/*.test.{m,c}js",
    "lint": "deno lint",
    "fmt": "deno fmt && deno task cli cli.ts mod.ts src tests examples -r",
    "docs": "deno doc --html --output=docs mod.ts",
    "cli": "deno run --allow-read --allow-write --allow-env cli.ts"
  },
  "publish": {
    "exclude": [
      ".git",
      ".github/",
      "opencode.jsonc",
      "MODERNIZATION.md",
      "tests/",
      "examples/",
      "docs/",
      "icon/"
    ]
  }
}
