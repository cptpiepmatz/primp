{
  "workspace": ["./packages/*"],
  "nodeModulesDir": "auto",
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.8",
    "@std/path": "jsr:@std/path@^1.1.6",
    "typescript": "npm:typescript@^6.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false
  },
  "fmt": {
    "newLineKind": "auto",
    "exclude": ["./icon/"]
  },
  "test": {
    "sanitizeOps": true,
    "sanitizeResources": true
  },
  "tasks": {
    "check": "deno check {packages,tests,examples}/**/*.ts primp.config.ts",
    "test": "deno task test:deno && deno task test:node",
    "test:deno": "deno test --allow-read --allow-write --allow-env tests/**/*.test.ts",
    "test:node": "node --test tests/**/*.test.{m,c}js",
    "lint": "deno lint",
    "fmt": "deno fmt && deno task cli -r packages tests examples primp.config.ts",
    "cli": "deno run --allow-read --allow-write --allow-env packages/primp/cli.ts"
  }
}
